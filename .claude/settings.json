{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.*.local)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.*.local)",
      "Edit(**/secrets/**)",
      "Bash(cat .env:*)",
      "Bash(type .env:*)",
      "Bash(git push --force:*)",
      "Bash(docker compose down -v:*)"
    ],
    "allow": [
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx prettier:*)",
      "Bash(npx oxlint:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(node -v)",
      "Bash(node scripts/setup-env.mjs)",
      "Bash(docker info)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(ollama list)",
      "Bash(ollama pull:*)",
      "Bash(ollama ps)",
      "Bash(ollama --version)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -I http://localhost:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git init:*)",
      "Bash(gh auth status)"
    ]
  },
  "model": "opus"
}
